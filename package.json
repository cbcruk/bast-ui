{
  "name": "bast-ui",
  "version": "0.0.0",
  "description": "Headless, accessible UI primitives as native web components — a Base UI/Radix-style layer built on FAST.",
  "keywords": [
    "accessible",
    "base-ui",
    "custom-elements",
    "fast-element",
    "headless-ui",
    "radix",
    "web-components"
  ],
  "homepage": "https://github.com/cbcruk/bast-ui#readme",
  "bugs": {
    "url": "https://github.com/cbcruk/bast-ui/issues"
  },
  "license": "MIT",
  "author": "Eunsoo Lee <cbcruk@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbcruk/bast-ui.git"
  },
  "files": [
    "custom-elements.json",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./accordion": "./dist/accordion.mjs",
    "./checkbox": "./dist/checkbox.mjs",
    "./collapsible": "./dist/collapsible.mjs",
    "./dialog": "./dist/dialog.mjs",
    "./menu": "./dist/menu.mjs",
    "./popover": "./dist/popover.mjs",
    "./radio-group": "./dist/radio-group.mjs",
    "./select": "./dist/select.mjs",
    "./switch": "./dist/switch.mjs",
    "./tabs": "./dist/tabs.mjs",
    "./toast": "./dist/toast.mjs",
    "./tooltip": "./dist/tooltip.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "cem": "cem analyze",
    "prepublishOnly": "vp run cem && vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@microsoft/fast-element": "^3.0.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20"
  },
  "packageManager": "pnpm@11.10.0",
  "customElements": "custom-elements.json"
}
